for (gene in genes_to_plot) {
  ebg <- split(norm_counts[gene, ], coldata$group)
  aov_res <- tryCatch(summary(aov(expr ~ group, data.frame(expr = as.numeric(norm_counts[gene,]), group = coldata$group))), error = function(e) NULL)
  anova_p <- ifelse(!is.null(aov_res), aov_res[[1]]$`Pr(>F)`[1], NA)
  for (grp in c("sgT","sgM","sgT-sgM")) {
    tt <- tryCatch(t.test(as.numeric(ebg[["SC"]]), as.numeric(ebg[[grp]])), error = function(e) list(p.value = NA))
    msc <- mean(as.numeric(ebg[["SC"]])); mt <- mean(as.numeric(ebg[[grp]]))
    fc <- mt / max(msc, 0.01)
    receptor_stats <- rbind(receptor_stats, data.frame(
      Gene = gene, Comparison = paste0(grp, "_vs_SC"), Mean_SC = round(msc, 2),
