    align(index = SAFE_INDEX_PREFIX, readfile1 = fi$R1, readfile2 = fi$R2,
          output_file = safe_bam, type = "rna", input_format = "gzFASTQ",
          nthreads = N_THREADS, unique = TRUE, nBestLocations = 1)
    sp <- file.path(ALIGN_DIR, paste0(fi$sample_name, ".sorted"))
    sb <- paste0(sp, ".bam"); sortBam(real_bam, sp); indexBam(sb)
    file.remove(real_bam); file.rename(sb, real_bam)
    if (file.exists(paste0(sb, ".bai"))) file.rename(paste0(sb, ".bai"), paste0(real_bam, ".bai"))
