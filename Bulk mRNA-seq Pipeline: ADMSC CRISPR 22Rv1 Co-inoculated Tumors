# --- Helper: fuzzy-match a pathway name in the GSEA results ---
# The hardcoded "HALLMARK_*" names may not exactly match what fgsea stored
# (e.g. fgsea uses data.table pathway column from all_gene_sets which may
#  have been loaded under a slightly different name by msigdbr).
# This function tries: exact match -> grep match -> NA.
find_pathway_in_gsea <- function(pathway_id, gsea_df) {
  # 1. Exact match
  row <- gsea_df[gsea_df$pathway == pathway_id, ]
  if (nrow(row) > 0) return(row[1, ])

  # 2. Grep: extract the core name (strip HALLMARK_ prefix) and search
  core <- gsub("^HALLMARK_", "", pathway_id)
  candidates <- gsea_df$pathway[grepl(core, gsea_df$pathway, fixed = TRUE)]
  if (length(candidates) > 0) {
    row <- gsea_df[gsea_df$pathway == candidates[1], ]
    if (nrow(row) > 0) return(row[1, ])
  }

  # 3. Not found — return single-row data.frame with NAs
  return(data.frame(pathway = pathway_id, NES = NA_real_, padj = NA_real_,
                    stringsAsFactors = FALSE))
}

