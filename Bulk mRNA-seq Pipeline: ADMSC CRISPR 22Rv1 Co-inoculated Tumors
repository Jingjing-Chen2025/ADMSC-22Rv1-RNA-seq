  ns <- combined_nes$NES_sgT_vs_SC[i]; nm <- combined_nes$NES_sgM_vs_SC[i]; nd <- combined_nes$NES_sgTsgM_vs_SC[i]
  ps <- combined_nes$padj_sgT_vs_SC[i]; pm <- combined_nes$padj_sgM_vs_SC[i]; pd <- combined_nes$padj_sgTsgM_vs_SC[i]
  ss <- !is.na(ps) && ps < 0.25; sm <- !is.na(pm) && pm < 0.25; sd <- !is.na(pd) && pd < 0.25

  cl <- "Not significant"
  if (ss && !sm) cl <- "TNFSF12-specific"
  else if (!ss && sm) cl <- "MDK-specific"
  else if (ss && sm && sd && !is.na(nd) && abs(nd) > max(abs(ns), abs(nm), na.rm = TRUE)) cl <- "Synergistic"
  else if (ss && sm) cl <- "Shared"
  else if (sd && !ss && !sm) cl <- "Dual-KO-specific"
  if (cl == "Not significant") next

  pd2 <- gsub("^HALLMARK_", "", pw); pd2 <- gsub("^CUSTOM_", "* ", pd2)
  pathway_classification <- rbind(pathway_classification, data.frame(
    Pathway = pd2, Pathway_ID = pw, Is_Custom = grepl("^CUSTOM_", pw), Classification = cl,
