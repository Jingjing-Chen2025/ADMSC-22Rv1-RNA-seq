extract_receptor_genes <- function(df) {
  receptors <- unique(unlist(strsplit(as.character(df$receptor), "[_+, ]+")))
  receptors <- receptors[receptors != "" & !is.na(receptors)]
  expanded <- c()
  for (r in receptors) {
    if (r %in% rownames(complex_db)) {
      cc <- unlist(complex_db[r, ]); expanded <- c(expanded, cc[cc != "" & !is.na(cc)])
    } else expanded <- c(expanded, r)
  }
  unique(expanded)
}

