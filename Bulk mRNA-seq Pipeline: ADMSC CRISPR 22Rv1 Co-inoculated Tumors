find_c2_pathway_name <- function(target_name, available_names) {
  if (target_name %in% available_names) return(target_name)
  idx <- which(tolower(available_names) == tolower(target_name))
  if (length(idx) > 0) return(available_names[idx[1]])
  idx <- grep(target_name, available_names, fixed = TRUE)
  if (length(idx) > 0) return(available_names[idx[1]])
  idx <- grep(target_name, available_names, ignore.case = TRUE, fixed = TRUE)
  if (length(idx) > 0) return(available_names[idx[1]])
  alt <- gsub("_", ".", target_name)
  idx <- grep(alt, available_names, ignore.case = TRUE, fixed = TRUE)
  if (length(idx) > 0) return(available_names[idx[1]])
  core <- gsub("^(REACTOME_|KEGG_|PID_|WP_|BIOCARTA_)", "", target_name)
  idx <- grep(core, available_names, ignore.case = TRUE, fixed = TRUE)
  if (length(idx) > 0) return(available_names[idx[1]])
  return(NA_character_)
}

