scan_fastq_files <- function(sample_info_row) {
  sample_name <- sample_info_row$sample_name
  folder      <- sample_info_row$folder
  sample_dir  <- file.path(SAFE_FASTQ_DIR, folder)
  if (!dir.exists(sample_dir)) { warning(sprintf("Not found: %s", sample_dir)); return(NULL) }
  all_files <- list.files(sample_dir, full.names = TRUE, recursive = TRUE)
  r1 <- all_files[grepl(paste0(sample_name, ".*R1.*\\.fastq\\.gz$"), basename(all_files), ignore.case = TRUE)]
  r2 <- all_files[grepl(paste0(sample_name, ".*R2.*\\.fastq\\.gz$"), basename(all_files), ignore.case = TRUE)]
  r1 <- r1[!grepl("\\.md5$", r1)]; r2 <- r2[!grepl("\\.md5$", r2)]
  md5 <- all_files[grepl(paste0(sample_name, ".*\\.fastq\\.gz\\.md5$"), basename(all_files), ignore.case = TRUE)]
  list(sample_name = sample_name, group = sample_info_row$group,
       R1 = sort(r1), R2 = sort(r2), md5 = sort(md5))
}

