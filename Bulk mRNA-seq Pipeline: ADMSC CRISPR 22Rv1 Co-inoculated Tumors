# HELPER: Build enrichment plot with NES/padj in corner
# ============================================================
# Positive NES -> annotation at TOP-RIGHT corner
# Negative NES -> annotation at BOTTOM-LEFT corner
# Uses Inf/-Inf positioning with hjust/vjust to anchor text
# exactly in the corner of the plot panel, guaranteeing no
# overlap with the enrichment curve or rug marks.

build_enrichment_plot <- function(gene_set, stats, nes_val, padj_val,
                                  size_val, title_text, subtitle_text) {

  # --- Get enrichment curve ---
  enrich_obj <- plotEnrichment(gene_set, stats)

  n_genes <- length(stats)

  # --- Build stat label ---
  stat_label <- sprintf("NES = %+.2f\nPadj = %.2e\nn = %d genes",
                         nes_val, padj_val, size_val)
  nes_color <- ifelse(nes_val > 0, "#B2182B", "#2166AC")

  # --- Position: corner placement using Inf/-Inf ---
  # Positive NES: top-right corner
  #   x = +Inf (right edge), y = +Inf (top edge)
  #   hjust = 1 (text right-aligned to x), vjust = 1 (text top-aligned to y)
  #   Small inset via nudge to avoid touching the axis frame
  #
  # Negative NES: bottom-left corner
  #   x = -Inf (left edge), y = -Inf (bottom edge)
  #   hjust = 0 (text left-aligned to x), vjust = 0 (text bottom-aligned to y)

  if (nes_val > 0) {
    annot_x     <- Inf
    annot_y     <- Inf
    annot_hjust <- 1.05   # slight inset from right frame
    annot_vjust <- 1.15   # slight inset from top frame
  } else {
    annot_x     <- -Inf
    annot_y     <- -Inf
