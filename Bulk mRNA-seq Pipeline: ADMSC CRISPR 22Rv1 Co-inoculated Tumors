cat("\n   Validating MD5 checksums...\n")
validate_md5 <- function(fi) {
  if (length(fi$md5) == 0) { cat(sprintf("   [SKIP] %s\n", fi$sample_name)); return(TRUE) }
  all_pass <- TRUE
  for (md5_file in fi$md5) {
    for (line in readLines(md5_file, warn = FALSE)) {
      parts <- strsplit(trimws(line), "\\s+")[[1]]
      if (length(parts) >= 2) {
        target_file <- file.path(dirname(md5_file), gsub("^\\*", "", parts[2]))
        if (file.exists(target_file)) {
          actual <- tools::md5sum(target_file)
          if (tolower(actual) == tolower(parts[1])) cat(sprintf("   [PASS] %s: %s\n", fi$sample_name, basename(target_file)))
          else { cat(sprintf("   [FAIL] %s: %s\n", fi$sample_name, basename(target_file))); all_pass <- FALSE }
        }
      }
    }
  }
  all_pass
}
md5_results <- sapply(fastq_inventory, function(fi) if (!is.null(fi)) validate_md5(fi) else NA)
