# --- 9h.8 Fuzzy-match helper ---
find_c6_pathway_name <- function(target_name, available_names) {
  if (target_name %in% available_names) return(target_name)
  alt <- gsub("\\.", "_", target_name)
  if (alt %in% available_names) return(alt)
  idx <- grep(target_name, available_names, ignore.case = TRUE, fixed = TRUE)
  if (length(idx) > 0) return(available_names[idx[1]])
  idx2 <- grep(alt, available_names, ignore.case = TRUE, fixed = TRUE)
  if (length(idx2) > 0) return(available_names[idx2[1]])
  core <- gsub("\\.V1_(UP|DN)$", "", target_name)
  core_alt <- gsub("_V1_(UP|DN)$", "", alt)
  suffix <- sub(".*V1_", "", target_name)
  idx3 <- grep(core_alt, available_names, ignore.case = TRUE, fixed = TRUE)
  if (length(idx3) > 0) {
    exact_match <- idx3[grepl(paste0("V1_", suffix, "$"), available_names[idx3], ignore.case = TRUE)]
    if (length(exact_match) > 0) return(available_names[exact_match[1]])
    return(available_names[idx3[1]])
  }
  return(NA_character_)
}

