integrated_summary <- data.frame()
for (cn in key_contrasts) {
  ts <- triangulation_results[triangulation_results$Contrast == cn, ]
  for (j in seq_len(nrow(ts))) {
    pid <- ts$Pathway_ID[j]
    as2 <- anchor_results[anchor_results$Contrast == cn & anchor_results$Pathway_ID == pid, ]
    ms <- if (nrow(as2) > 0) max(as2$Support_score) else 0
    br <- if (nrow(as2) > 0) as2$Receptor[which.max(as2$Support_score)] else "—"
    cs2 <- ts$Convergence_score[j] + ms
    oc <- if (cs2 >= 7) "Very High" else if (cs2 >= 5) "High" else if (cs2 >= 3) "Medium" else "Low"
    integrated_summary <- rbind(integrated_summary, data.frame(
      Contrast = cn, Pathway = ts$Pathway[j], GSEA_NES = ts$NES[j],
      Signal_source = ts$Signal_source[j], Convergence = ts$Convergence_score[j],
      Best_receptor = br, Anchor = ms, Combined = cs2, Confidence = oc, stringsAsFactors = FALSE))
  }
}
integrated_summary <- integrated_summary[order(-integrated_summary$Combined), ]
write.csv(integrated_summary, file.path(VALID_DIR, "integrated_confidence.csv"), row.names = FALSE)

