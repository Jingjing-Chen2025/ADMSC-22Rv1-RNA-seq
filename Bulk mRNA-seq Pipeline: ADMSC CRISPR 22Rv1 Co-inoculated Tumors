make_unique_display_names <- function(x) {
  dupes <- duplicated(x) | duplicated(x, fromLast = TRUE)
  if (any(dupes)) {
    dupe_vals <- unique(x[dupes])
    for (dv in dupe_vals) {
      idx <- which(x == dv)
      x[idx] <- paste0(x[idx], " (", seq_along(idx), ")")
    }
  }
  return(x)
}

