load_msigdb_collection <- function(category, subcategory = NULL, label = NULL) {
  tag <- ifelse(!is.null(subcategory), paste0(category, ":", subcategory), category)
  dl <- ifelse(is.null(label), tag, label)
  tryCatch({
    gs <- if (!is.null(subcategory)) msigdbr(species = "Homo sapiens", category = category, subcategory = subcategory)
          else msigdbr(species = "Homo sapiens", category = category)
    result <- split(gs$gene_symbol, gs$gs_name)
    cat(sprintf("     [%s] %s: %d sets\n", tag, dl, length(result)))
    result
  }, error = function(e) { cat(sprintf("     [%s] %s: FAILED (%s)\n", tag, dl, e$message)); list() })
}

discover_subcategories <- function(category) {
  gs_all <- tryCatch(msigdbr(species = "Homo sapiens", category = category), error = function(e) NULL)
  if (is.null(gs_all) || nrow(gs_all) == 0) return(character(0))
  subcats <- unique(gs_all$gs_subcat)
  subcats <- subcats[subcats != "" & !is.na(subcats)]
  cat(sprintf("   Available %s subcategories: %s\n", category, paste(subcats, collapse = ", ")))
  subcats
}

load_by_pattern <- function(category, desired_list) {
  subcats <- discover_subcategories(category)
  result <- list()
  for (d in desired_list) {
    matched <- subcats[grepl(d$pattern, subcats, ignore.case = TRUE)]
    if (length(matched) > 0) {
      sub_list <- load_msigdb_collection(category, matched[1], label = d$label)
      result <- c(result, sub_list)
    } else {
      cat(sprintf("     [%s:%s] not found, skipping\n", category, d$pattern))
    }
  }
  if (length(result) == 0) {
    cat(sprintf("   No %s subcategories matched. Loading entire %s...\n", category, category))
    result <- load_msigdb_collection(category, label = paste0(category, " (all)"))
  }
  result
}

